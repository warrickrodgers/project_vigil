# Root .env is used by scripts/seed.ts (runs from repo root, cwd-relative path).
# packages/db/.env is used by Prisma CLI (migrate/studio, schema-relative path).
# Both resolve to the same physical file: packages/db/prisma/dev.db
DATABASE_URL="file:./packages/db/prisma/dev.db"
# Populated in Phase 1:
# GROQ_API_KEY=
# GEMINI_API_KEY=
# TAVILY_API_KEY=
# AWS_REGION=us-east-1

# Discord bot (Phase 1a)
# DISCORD_BOT_TOKEN=          # Bot token from Discord Developer Portal
# DISCORD_CLIENT_ID=          # Application (client) ID
# DISCORD_GUILD_ID=           # Your dev/prod server ID
# DISCORD_GENERAL_CHANNEL_ID= # #vigil-general channel ID
# DISCORD_LOCAL_CHANNEL_ID=   # #vigil-local channel ID
# DISCORD_USA_CHANNEL_ID=     # #vigil-usa channel ID
# DISCORD_GEO_CHANNEL_ID=     # #vigil-geopolitical channel ID
# DISCORD_ADMIN_USER_ID=      # Your Discord user ID (commands are admin-only)
