# NODE_ENV controls which database URL is used at runtime:
#   development → DEV_DATABASE_URL (local Docker Postgres)
#   production  → DATABASE_URL (Supabase)
NODE_ENV=development

# Dev DB — local Docker Postgres (npm run db:up to start)
DEV_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vigil_dev

# Prod DB — Supabase
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
# AI — Gemini (collection + summarization via fast tier; editing + newsletter via capable tier)
# GEMINI_API_KEY=                                            # required for Phase 1b+
# GEMINI_FAST_MODEL=gemini-3.1-flash-lite-preview           # optional override
# GEMINI_CAPABLE_MODEL=gemini-3-flash-preview               # optional override

# ChromaDB Cloud — semantic corroboration (Phase 2b)
# Get credentials from https://www.trychroma.com
CHROMADB_CLOUD_API_KEY=ck-...
CHROMADB_CLOUD_TENANT_ID=your-tenant-id
# Falls back to CHROMA_URL (local Docker) if cloud vars are absent
# CHROMA_URL=http://localhost:8000

# Search — Tavily
# TAVILY_API_KEY=                                           # required for Phase 1b+
# TAVILY_MONTHLY_LIMIT=1000                                 # optional, default 1000

# AWS — Lambda + SES dispatch (Phase 2c)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=               # IAM user with Lambda + SES invoke permissions
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_ADDRESS=vigil@yourdomain.com      # Must be SES-verified sender address
# NEWSLETTER_RECIPIENTS=you@email.com,other@email.com  # Comma-separated recipient list

# Database — Supabase (Phase 2c: swap from SQLite to Postgres)
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Discord bot (Phase 1a)
# DISCORD_BOT_TOKEN=          # Bot token from Discord Developer Portal
# DISCORD_CLIENT_ID=          # Application (client) ID
# DISCORD_GUILD_ID=           # Your dev/prod server ID
# DISCORD_GENERAL_CHANNEL_ID= # #vigil-general channel ID
# DISCORD_LOCAL_CHANNEL_ID=   # #vigil-local channel ID
# DISCORD_USA_CHANNEL_ID=     # #vigil-usa channel ID
# DISCORD_GEO_CHANNEL_ID=     # #vigil-geopolitical channel ID
# DISCORD_ADMIN_USER_ID=      # Your Discord user ID (commands are admin-only)
