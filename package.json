{
  "name": "project-vigil",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "db:generate": "npm run generate -w packages/db",
    "db:migrate": "npm run migrate -w packages/db",
    "db:studio": "npm run studio -w packages/db",
    "db:seed": "DATABASE_URL=\"file:$(pwd)/packages/db/prisma/dev.db\" tsx scripts/seed.ts",
    "bot:dev": "npx tsx scripts/run-bot.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint packages --ext .ts",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
