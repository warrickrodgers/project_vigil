generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Outlet {
  id              String    @id @default(cuid())
  canonicalName   String    @unique // "Reuters", "KC Star", "SCMP"
  aliases         String // JSON-encoded string[] of known variant names
  biasAnchor      Float // -1.0 to 1.0, seed value from AllSides/Ad Fontes
  reliabilityBase Float // 0.0-1.0, baseline trust (separate from per-article trustRating)
  region          String? // optional primary region, nullable (Reuters is global)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  articles Article[]

  @@index([canonicalName])
}

model Article {
  id               String    @id @default(cuid())
  url              String    @unique
  hash             String    @unique // sha256 of normalized(title)+"\n"+normalized(rawContent), for wire-story dedup
  title            String
  summary          String
  rawContent       String? // full fetched body; null if fetch failed
  outletId         String
  outlet           Outlet    @relation(fields: [outletId], references: [id])
  biasScore        Float // -1.0 (left) to 1.0 (right), 0 = center
  trustRating      Float // 0.0–1.0, derived from outlet.reliabilityBase + bias + corroboration
  region           String // "local" | "usa" | "geopolitical"
  sectorTags       String // JSON-encoded string[] (SQLite has no native arrays)
  corroboratedById String? // FK → Article.id, nullable
  corroboratedBy   Article?  @relation("Corroboration", fields: [corroboratedById], references: [id])
  corroborates     Article[] @relation("Corroboration")
  vettingFlag      String? // BIAS | UNVERIFIED | DUPLICATE | LOW_TRUST | UNKNOWN_OUTLET — null = auto-approved
  embeddingId      String? // ChromaDB pointer, Phase 2b
  publishedAt      DateTime
  collectedAt      DateTime  @default(now())

  @@index([region, collectedAt])
  @@index([outletId])
  @@index([publishedAt])
}

model BudgetState {
  id         String   @id @default("singleton")
  monthKey   String // "2026-04"
  monthCount Int      @default(0)
  dayKey     String // "2026-04-23"
  dayCount   Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model Subscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  tier             String   // "free" | "pro" | "regional_pro" | "enterprise"
  stripeCustomerId String?
  active           Boolean  @default(true)
  preferences      String?  // JSON: { regions?: string[], sectors?: string[] }
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active, tier])
}
